# Optional. Copy to `.env` next to docker-compose.yml; compose reads it automatically.
# Every value here has a working default — Lite generates its own secrets on first boot —
# so an empty .env, or no .env at all, is a valid setup.

# Pin your own gateway bearer key instead of the generated one. MCP/LLM clients send this.
#   openssl rand -hex 24
MCP_API_KEY=

# Pin your own UI login instead of the generated password.
UI_ADMIN_PASSWORD=
UI_VIEWER_PASSWORD=

# Signs UI session cookies. Generated and persisted on first boot if left empty.
#   openssl rand -hex 32
SESSION_SECRET=

# Encrypts stored device credentials at rest. Empty = stored in plaintext in SQLite, which is
# the documented default for a single-operator box. Set one if the data volume might be copied
# off the machine (a snapshot, a NAS sync, a support bundle):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_SECRET_KEY=

# Home devices live on private ranges, so the SSRF guard allows them by default.
# Set to false if this gateway should only ever reach public addresses.
MCP_ALLOW_PRIVATE_TARGETS=true
